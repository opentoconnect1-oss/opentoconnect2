# Production site URL (used for canonical metadata, sitemap, and robots.txt)
NEXT_PUBLIC_SITE_URL=

# WhatsApp Business number (international format digits only, no "+" or spaces, e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Verified public contact email (leave blank until active)
NEXT_PUBLIC_CONTACT_EMAIL=

# Email delivery via Resend (server-only — never prefix with NEXT_PUBLIC_)
RESEND_API_KEY=
CONTACT_RECIPIENT_EMAIL=
CONTACT_FROM_EMAIL=
